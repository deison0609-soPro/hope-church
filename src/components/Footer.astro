---
<footer class="bg-gray-900 text-gray-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <img src="/images/logo.png" alt="台中希望教會" class="h-12 w-auto mb-4" />
        <p class="text-sm text-gray-400 leading-relaxed">
          讓愛天天住你家<br />
          台中希望教會歡迎您
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-white font-semibold mb-4">快速連結</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="hover:text-hope-green transition-colors">關於希望</a></li>
          <li><a href="/news" class="hover:text-hope-green transition-colors">最新消息</a></li>
          <li><a href="/pastor/messages" class="hover:text-hope-green transition-colors">主日信息</a></li>
          <li><a href="/pastor/groups" class="hover:text-hope-green transition-colors">加入小組</a></li>
          <li><a href="/happiness" class="hover:text-hope-green transition-colors">幸福小聚</a></li>
          <li><a href="/youth" class="hover:text-hope-green transition-colors">未來領袖</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-4">聯絡資訊</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 text-hope-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <a href="https://maps.google.com/maps?q=台中市南區工學北路169號" target="_blank" rel="noopener noreferrer" class="hover:text-hope-green transition-colors">台中市南區工學北路169號</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-hope-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:0422651572" class="hover:text-hope-green transition-colors">(04) 2265-1572</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-hope-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:17hopechurch@gmail.com" class="hover:text-hope-green transition-colors">17hopechurch@gmail.com</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-4 h-4 text-hope-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>週一至週五　09:00–17:30</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-10 pt-6 text-center text-xs text-gray-500">
      © {new Date().getFullYear()} 台中希望教會　All rights reserved.
    </div>
  </div>
</footer>
