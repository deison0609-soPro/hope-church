---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="聯絡我們" description="聯絡台中希望教會——地址、電話、信箱、服務時間">

  <div class="bg-hope-green-light border-b border-green-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">聯絡我們</h1>
      <p class="mt-2 text-gray-600">歡迎隨時與我們聯繫</p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">

      <!-- 聯絡資訊 -->
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-gray-900 mb-6">教會資訊</h2>
          <div class="space-y-5">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-hope-green-light rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-hope-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900">教會地址</p>
                <p class="text-gray-600 mt-0.5">台中市南區工學北路169號</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-hope-green-light rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-hope-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.948V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900">幸福專線</p>
                <a href="tel:0422651572" class="text-hope-green hover:underline mt-0.5 block">(04) 2265-1572</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-hope-green-light rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-hope-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900">電子信箱</p>
                <a href="mailto:17hopechurch@gmail.com" class="text-hope-green hover:underline mt-0.5 block">17hopechurch@gmail.com</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-hope-green-light rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-hope-green" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-900">服務時間</p>
                <p class="text-gray-600 mt-0.5">週一至週五　AM 09:00 – PM 17:30</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Google Maps placeholder -->
        <div class="rounded-xl overflow-hidden h-56 shadow-sm">
          <iframe
            src="https://maps.google.com/maps?q=台中市南區工學北路169號&t=&z=16&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="台中希望教會地圖"
          ></iframe>
        </div>
      </div>

      <!-- 聯絡表單說明 -->
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">留下你的資料</h2>
        <p class="text-gray-600 mb-6 leading-relaxed">
          歡迎留下資料，我們很期待更多認識你。無論你有任何問題、想了解小組或活動，都歡迎與我們聯繫！
        </p>
        <form
          action="https://formspree.io/f/meajkbbq"
          method="POST"
          class="space-y-4"
        >
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">您的大名 <span class="text-red-500">*</span></label>
            <input type="text" name="姓名" required
              class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">聯絡電話 <span class="text-red-500">*</span></label>
            <input type="tel" name="電話" required
              class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">電子郵件 <span class="text-red-500">*</span></label>
            <input type="email" name="email" required
              class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">現居地址</label>
            <input type="text" name="地址"
              class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">適合聯絡的時間</label>
            <select name="聯絡時間"
              class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition bg-white">
              <option value="">請選擇</option>
              <option value="平日白天">平日白天</option>
              <option value="平日晚上">平日晚上</option>
              <option value="週末">週末</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">留言</label>
            <textarea name="留言" rows="3"
              class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition resize-none"></textarea>
          </div>
          <button type="submit"
            class="w-full py-3 bg-hope-green text-white font-semibold rounded-lg hover:bg-hope-green-dark transition-colors">
            送出
          </button>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>
