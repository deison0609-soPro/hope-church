---
import BaseLayout from '../../layouts/BaseLayout.astro';

const groups = [
  {
    name: '柯哥小組',
    leader: '柯哥',
    desc: '是資深帥哥美女的園地！雖然兒女都已長大成人，但空虛寂寞卻不是我們的代名詞！因為在這個美好的家充滿活力、希望，主的愛使我們更加茁壯、強健。',
    time: '週四晚上 19:30–21:30',
    tag: '銀髮族',
    color: 'bg-purple-50 border-purple-200',
    tagColor: 'bg-purple-100 text-purple-700',
  },
  {
    name: '德松小組',
    leader: '德松',
    desc: '壯年族的成長天地，只要你的年齡至不惑之年，都歡迎您的加入，讓神的祝福大大的臨到你！',
    time: '週五晚上 20:00–21:30',
    tag: '壯年族',
    color: 'bg-blue-50 border-blue-200',
    tagColor: 'bg-blue-100 text-blue-700',
  },
  {
    name: '政億小組',
    leader: '政億',
    desc: '年輕人與年輕夫妻的組合，讓青春的火花在此點燃，陪伴你從單身進入已婚，陪你的家庭更加美滿。有基督的愛使一切夢想都將變成可能！',
    time: '週日下午 12:30–14:00',
    tag: '年輕夫妻',
    color: 'bg-orange-50 border-orange-200',
    tagColor: 'bg-orange-100 text-orange-700',
  },
  {
    name: '士倚小組',
    leader: '士倚',
    desc: '充滿朝氣、有活力的年輕人與滿腔熱血、活躍的年輕夫妻組合！除了每週的小組，更時常相約出遊聚會，不僅僅只是教會中的屬靈家人、更是日常生活中互相扶持、彼此關懷相愛的家人朋友。',
    time: '週四晚上 19:40–21:10',
    tag: '年輕活力',
    color: 'bg-yellow-50 border-yellow-200',
    tagColor: 'bg-yellow-100 text-yellow-700',
  },
  {
    name: '聖閔小組',
    leader: '聖閔',
    desc: '歡迎你一起加入參與我們彼此生命中重要的時刻，以及點點滴滴～在這裡，我們永遠隨時歡迎你！一起奔跑天路，你。不。孤。單！',
    time: '週五晚上 19:40–21:10',
    tag: '溫馨包容',
    color: 'bg-pink-50 border-pink-200',
    tagColor: 'bg-pink-100 text-pink-700',
  },
  {
    name: '主豪小組',
    leader: '主豪',
    desc: '充滿著愛和年輕活力，彼此關心和支持，相互分享生活的點滴，建立了深厚的友誼！並相信上帝的引導和祝福，給予我們方向和力量，是一個充滿溫暖、希望和愛的小組。',
    time: '週二晚上 19:40–21:10',
    tag: '年輕有愛',
    color: 'bg-green-50 border-green-200',
    tagColor: 'bg-green-100 text-green-700',
  },
];
---
<BaseLayout title="加入小組" description="台中希望教會小組一覽——找到屬於你的屬靈家人">

  <div class="bg-hope-green-light border-b border-green-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
      <nav class="text-sm text-gray-500 mb-3">
        <a href="/pastor" class="hover:text-hope-green">牧者頻道</a>
        <span class="mx-2">/</span>
        <span>加入小組</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">加入小組</h1>
      <p class="mt-2 text-gray-600">找到屬於你的屬靈家人</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 space-y-16">

    <!-- 小組列表 -->
    <section>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {groups.map((group) => (
          <div class={`rounded-2xl border p-6 ${group.color}`}>
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-xl font-bold text-gray-900">{group.name}</h3>
              <span class={`text-xs font-medium px-2.5 py-1 rounded-full flex-shrink-0 ml-2 ${group.tagColor}`}>
                {group.tag}
              </span>
            </div>
            <p class="text-gray-700 text-sm leading-relaxed mb-4">{group.desc}</p>
            <div class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-4 h-4 text-hope-green flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="font-medium">{group.time}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 報名表單 -->
    <section class="bg-gray-50 rounded-2xl p-8 md:p-10">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">很高興您來到台中希望教會</h2>
        <p class="text-gray-600">歡迎留下資料，期待更多認識您！</p>
      </div>

      <div id="groups-success" class="hidden bg-hope-green-light border border-hope-green rounded-xl p-6 text-center">
        <div class="text-4xl mb-3">🙏</div>
        <h3 class="text-lg font-bold text-hope-green-dark mb-1">報名成功！</h3>
        <p class="text-gray-600 text-sm">我們已收到您的報名資料，將盡快與您聯繫，歡迎加入希望教會大家庭！</p>
      </div>

      <form
        id="groups-form"
        action="https://formspree.io/f/meajkbbq"
        method="POST"
        class="space-y-4"
      >
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">您的大名 <span class="text-red-500">*</span></label>
          <input type="text" name="姓名" required
            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">聯絡電話 <span class="text-red-500">*</span></label>
          <input type="tel" name="電話" required
            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">電子郵件 <span class="text-red-500">*</span></label>
          <input type="email" name="email" required
            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">現居地址</label>
          <input type="text" name="地址"
            class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">想加入的小組</label>
          <select name="小組" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition bg-white">
            <option value="">請選擇</option>
            <option value="柯哥小組">柯哥小組（週四 19:30）</option>
            <option value="德松小組">德松小組（週五 20:00）</option>
            <option value="政億小組">政億小組（週日 12:30）</option>
            <option value="士倚小組">士倚小組（週四 19:40）</option>
            <option value="聖閔小組">聖閔小組（週五 19:40）</option>
            <option value="主豪小組">主豪小組（週二 19:40）</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">適合聯絡的時間</label>
          <select name="聯絡時間" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-hope-green focus:border-transparent transition bg-white">
            <option value="">請選擇</option>
            <option value="平日白天">平日白天</option>
            <option value="平日晚上">平日晚上</option>
            <option value="週末">週末</option>
          </select>
        </div>
        <button type="submit"
          class="w-full py-3 bg-hope-green text-white font-semibold rounded-lg hover:bg-hope-green-dark transition-colors">
          送出報名
        </button>
      </form>

      <script>
        const form = document.getElementById('groups-form');
        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const data = new FormData(form);
          const res = await fetch(form.action, {
            method: 'POST',
            body: data,
            headers: { 'Accept': 'application/json' }
          });
          if (res.ok) {
            form.classList.add('hidden');
            document.getElementById('groups-success')?.classList.remove('hidden');
          }
        });
      </script>

      <div class="mt-8 pt-6 border-t border-gray-200 text-center space-y-1 text-sm text-gray-600">
        <p>幸福專線：<a href="tel:0422651572" class="text-hope-green">(04) 2265-1572</a></p>
        <p>希望信箱：<a href="mailto:17hopechurch@gmail.com" class="text-hope-green">17hopechurch@gmail.com</a></p>
        <p>教會地址：台中市南區工學北路169號</p>
        <p>服務時間：AM 09:00 – PM 17:30</p>
      </div>
    </section>

  </div>
</BaseLayout>
