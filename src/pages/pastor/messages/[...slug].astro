---
import { getCollection } from 'astro:content';
import MessageLayout from '../../../layouts/MessageLayout.astro';

export async function getStaticPaths() {
  const messages = await getCollection('messages');
  return messages.map((msg) => ({
    params: { slug: msg.slug },
    props: { msg },
  }));
}

const { msg } = Astro.props;
const { Content } = await msg.render();
---
<MessageLayout
  title={msg.data.title}
  date={msg.data.date}
  description={msg.data.description}
  scripture={msg.data.scripture}
  youtube={msg.data.youtube}
>
  <Content />
</MessageLayout>
